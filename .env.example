# ============================================================
# NeuraWeb — variables d'environnement (exemple, sans secrets)
# Copier vers .env et remplir. Le .env réel est gitignored.
# ============================================================

# SEO (génération metadata) — lib/seo-ai-server.ts
ZAI_API_KEY=

# Mistral AI — chatbot du site (app/api/chat)
MISTRAL_API_KEY=

# Mistral AI — app mobile (routes /api/mobile/*) — clé DÉDIÉE
# Sert aussi à la génération de tweets, l'édition IA, les prompts visuels et
# la génération des posts d'articles (ex-workflows n8n).
MISTRAL_API_KEY_MOBILE=
# Modèle de rédaction des routes sociales (défaut : ministral-3b-latest). `mistral-small-latest`
# renvoie 429 sur la clé gratuite — ne le mettre ici que si le quota le permet.
MISTRAL_MODEL_CONTENT=

# Facebook — publication sur la Page depuis l'app (/api/mobile/facebook/publish)
# Page Access Token longue durée ; ⚠️ jamais côté app mobile.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optionnels : id de la Page (défaut = Page NeuraWeb) et version de l'API Graph (défaut v23.0)
FACEBOOK_PAGE_ID=
FACEBOOK_GRAPH_VERSION=

# X (Twitter) — collecte des métriques depuis l'app (/api/mobile/x/metrics).
# Lecture seule (API payante) : Bearer token de l'app X. X_USER_ID optionnel
# (défaut = compte NeuraWeb).
X_BEARER_TOKEN=
X_USER_ID=

# Google PageSpeed
PAGESPEED_API_KEY=

# Google Apps Script (formulaires / créneaux RDV — fallback Sheets)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
NEXT_PUBLIC_SPREADSHEET_ID=

# Google Analytics 4 (mesure côté client)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Property ID GA4 (Data API serveur, /api/mobile/analytics)
GA4_PROPERTY_ID=517812956
# En prod : JSON (ou base64) du compte de service Google (GA4 + GSC)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Resend — email transactionnel sortant
RESEND_API_KEY=
FROM_EMAIL=contact@neuraweb.fr
TO_EMAIL=contact@neuraweb.fr

# Supabase — RDV (bookings) + historique chatbot (chat_logs) + social posts
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Boîte mail contact@neuraweb.fr (cockpit mobile)
IMAP_HOST=mail.neuraweb.fr
IMAP_PORT=993
IMAP_USER=contact@neuraweb.fr
IMAP_PASSWORD=
SMTP_HOST=mail.neuraweb.fr
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Newsletter (footer du site) — secret partagé pour POST /api/newsletter/notify
NEWSLETTER_NOTIFY_SECRET=
