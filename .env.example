# ============================================================
# NeuraWeb — variables d'environnement (exemple, sans secrets)
# Copier vers .env et remplir. Le .env réel est gitignored.
# ============================================================

# SEO (génération metadata) — lib/seo-ai-server.ts
ZAI_API_KEY=

# Mistral AI — chatbot du site (app/api/chat)
MISTRAL_API_KEY=

# Mistral AI — app mobile (routes /api/mobile/*) — clé DÉDIÉE
MISTRAL_API_KEY_MOBILE=

# Google PageSpeed
PAGESPEED_API_KEY=

# Google Apps Script (formulaires / créneaux RDV — fallback Sheets)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=
NEXT_PUBLIC_SPREADSHEET_ID=

# Google Analytics 4 (mesure côté client)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Property ID GA4 (Data API serveur, /api/mobile/analytics)
GA4_PROPERTY_ID=517812956
# En prod : JSON (ou base64) du compte de service Google (GA4 + GSC)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Resend — email transactionnel sortant
RESEND_API_KEY=
FROM_EMAIL=contact@neuraweb.tech
TO_EMAIL=contact@neuraweb.tech

# Supabase — RDV (bookings) + historique chatbot (chat_logs) + social posts
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Boîte mail contact@neuraweb.tech (cockpit mobile)
IMAP_HOST=mail.neuraweb.tech
IMAP_PORT=143
IMAP_USER=contact@neuraweb.tech
IMAP_PASSWORD=
SMTP_HOST=mail.neuraweb.tech
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
