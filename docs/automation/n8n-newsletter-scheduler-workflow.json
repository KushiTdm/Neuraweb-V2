{
  "name": "NeuraWeb — Newsletter : envoi des campagnes programmées",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b1111111-1111-1111-1111-111111111111",
      "name": "Toutes les 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://neuraweb.tech/api/newsletter/process-scheduled",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.NEWSLETTER_NOTIFY_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 55000
        }
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Traiter les campagnes dues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "notes": "Déclenche l'envoi réel des campagnes `scheduled` dont scheduled_at est passé. Ne fait rien si aucune campagne n'est due. NEWSLETTER_NOTIFY_SECRET doit être identique à la variable Vercel du même nom."
    }
  ],
  "connections": {
    "Toutes les 5 minutes": {
      "main": [
        [
          {
            "node": "Traiter les campagnes dues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateId": "neuraweb-newsletter-scheduler"
  },
  "tags": [
    {
      "name": "neuraweb"
    },
    {
      "name": "newsletter"
    }
  ]
}
